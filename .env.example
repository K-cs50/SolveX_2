# ==============================================================================
# SolveX — Environment Configuration Template
# ==============================================================================

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend (FastAPI)
PROJECT_NAME="SolveX API"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local SQLite default:
DATABASE_URL="sqlite:///./solvex.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/solvex"

# Optional External AI/LLM API Keys (Enables extended generative synthesis if configured)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
